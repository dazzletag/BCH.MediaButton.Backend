# Copy to .env.local and fill in. Required for `npm run build` to embed
# auth config into the bundle. If these are missing the SPA still loads
# but MSAL fails with AADSTS900144 ("request body must contain client_id").

VITE_API_BASE_URL=https://mediabutton.azurewebsites.net
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=
# Optional — defaults to api://${VITE_AUTH_CLIENT_ID}/access_as_user
# VITE_AUTH_SCOPE=
