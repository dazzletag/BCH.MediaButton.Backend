[Unit]
Description=Media Button Pi client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/media-button
ExecStartPre=/usr/bin/git fetch --all
ExecStartPre=/usr/bin/git reset --hard origin/main
ExecStart=/usr/bin/python3 /opt/media-button/publish/pi/media_button_pi.py
Restart=always
RestartSec=5
User=media
Group=media
EnvironmentFile=/etc/media-button/env

[Install]
WantedBy=multi-user.target
