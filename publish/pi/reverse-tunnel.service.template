# MANAGED FILE - do not edit here.
#
# Rendered from publish/pi/reverse-tunnel.service.template by
# sync-system-files.sh on every media-button start, so local edits are
# overwritten. Change the template in the repo, or set TUNNEL_PORT /
# TUNNEL_LABEL in /etc/media-button/env for per-device values.
[Unit]
Description=Reverse SSH tunnel to bch-app VM (@@LABEL@@, port @@PORT@@)
After=network-online.target
Wants=network-online.target
[Service]
User=@@APP_USER@@
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N -o "ServerAliveInterval 30" -o "ServerAliveCountMax 3" -o "ExitOnForwardFailure yes" -o "StrictHostKeyChecking accept-new" -o "IdentitiesOnly yes" -i /home/@@APP_USER@@/.ssh/tunnel_key -R @@PORT@@:localhost:22 field-nursecall@bch-app.uksouth.cloudapp.azure.com
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
